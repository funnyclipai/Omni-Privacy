<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Privacy Policy - Omni Notes</title>
  <meta name="description" content="Privacy Policy for Omni Notes">

  <style>
    :root {
      --primary: #6c4cff;
      --primary2: #9b4dff;
      --text: #172033;
      --muted: #667085;
      --bg: #f6f7fb;
      --card: #ffffff;
      --border: #e7e9ef;
      --soft: #f0edff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.75;
    }

    .hero {
      background:
        radial-gradient(circle at top left, rgba(108,76,255,.35), transparent 35%),
        radial-gradient(circle at top right, rgba(155,77,255,.25), transparent 30%),
        linear-gradient(135deg, #11182d, #17113a 55%, #211447);
      color: white;
      padding: 70px 20px 85px;
      text-align: center;
    }

    .logo {
      width: 78px;
      height: 78px;
      margin: 0 auto 22px;
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #426cff, #a63dff);
      box-shadow: 0 15px 45px rgba(108, 76, 255, .35);
      font-size: 38px;
      font-weight: 800;
    }

    .hero h1 {
      font-size: clamp(34px, 7vw, 56px);
      line-height: 1.15;
      margin-bottom: 14px;
      letter-spacing: -1px;
    }

    .hero h1 span {
      background: linear-gradient(90deg, #ffffff, #b993ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      max-width: 700px;
      margin: auto;
      color: #d8dcf0;
      font-size: 17px;
    }

    .updated {
      display: inline-block;
      margin-top: 24px;
      padding: 8px 16px;
      border-radius: 999px;
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.15);
      color: #e8eaff;
      font-size: 14px;
    }

    .container {
      width: min(100% - 32px, 1050px);
      margin: -35px auto 60px;
      position: relative;
    }

    .content {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: clamp(24px, 5vw, 55px);
      box-shadow: 0 20px 60px rgba(16, 24, 40, .08);
    }

    .intro {
      background: var(--soft);
      border-left: 4px solid var(--primary);
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 35px;
      color: #3c4260;
    }

    .toc {
      background: #fafaff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 40px;
    }

    .toc h3 {
      margin-bottom: 12px;
      font-size: 18px;
    }

    .toc a {
      color: var(--primary);
      text-decoration: none;
      display: block;
      padding: 5px 0;
    }

    .toc a:hover {
      text-decoration: underline;
    }

    section {
      margin-bottom: 42px;
      scroll-margin-top: 25px;
    }

    section:last-child {
      margin-bottom: 0;
    }

    h2 {
      font-size: clamp(23px, 4vw, 30px);
      line-height: 1.3;
      margin-bottom: 15px;
      color: #141a2a;
    }

    h2::before {
      content: "";
      display: inline-block;
      width: 5px;
      height: 25px;
      background: linear-gradient(180deg, var(--primary), var(--primary2));
      border-radius: 10px;
      margin-right: 10px;
      vertical-align: -3px;
    }

    h3 {
      font-size: 19px;
      margin: 22px 0 8px;
    }

    p {
      margin-bottom: 14px;
      color: #475467;
    }

    ul {
      padding-left: 23px;
      margin: 12px 0 18px;
    }

    li {
      margin-bottom: 9px;
      color: #475467;
    }

    strong {
      color: #20283a;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin: 20px 0;
    }

    .info-card {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #fff;
    }

    .info-card strong {
      display: block;
      margin-bottom: 4px;
    }

    .highlight {
      padding: 18px 20px;
      border-radius: 14px;
      background: #f7f5ff;
      border: 1px solid #e5ddff;
      margin: 18px 0;
    }

    .contact {
      background:
        linear-gradient(135deg, #171d35, #24164b);
      color: white;
      border-radius: 18px;
      padding: 25px;
    }

    .contact h2,
    .contact p,
    .contact strong {
      color: white;
    }

    .contact h2::before {
      background: white;
    }

    .contact a {
      color: #d9c7ff;
      font-weight: 700;
    }

    .footer {
      text-align: center;
      padding: 30px 20px 45px;
      color: #7a8192;
      font-size: 14px;
    }

    .footer a {
      color: var(--primary);
      text-decoration: none;
    }

    @media (max-width: 650px) {
      .hero {
        padding: 50px 18px 70px;
      }

      .container {
        width: min(100% - 20px, 1050px);
        margin-top: -25px;
      }

      .content {
        border-radius: 18px;
        padding: 23px 18px;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

      h2::before {
        height: 21px;
        width: 4px;
      }
    }
  </style>
</head>

